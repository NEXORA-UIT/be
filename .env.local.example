NODE_ENV=development
PORT=3000
ATTACHMENT_STORAGE_PROVIDER=filesystem
# Chỉ dùng khi ATTACHMENT_STORAGE_PROVIDER=filesystem; đường dẫn tuyệt đối.
ATTACHMENT_STORAGE_DIR=

# Docker Compose local
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432
REDIS_PORT=6379

# Secret riêng của backend để ký JWT. Tạo một giá trị mới và chỉ lưu trong .env.local.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-generated-secret-at-least-32-bytes

# Nodemailer Gmail. Bật Google 2-Step Verification rồi tạo App Password.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=replace-with-google-app-password

# Frontend local URLs được chèn vào email.
AUTH_VERIFY_URL=http://localhost:5173/verify-email
AUTH_RESET_URL=http://localhost:5173/reset-password

# Google OAuth Web application lấy từ Google Cloud Console.
# Client ID có dạng: 123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Client Secret có dạng: GOCSPX-... và chỉ được lưu ở backend.
GOOGLE_CLIENT_SECRET=
# Google đưa trình duyệt về URL cố định này sau khi đăng nhập.
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback/google
# Thời gian giữ loginToken/state trong Redis. 600 giây = 10 phút.
OAUTH_STATE_TTL_SECONDS=600
