generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum BoardRole {
  PM
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELED
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique
  passwordHash         String?
  fullName             String
  avatarUrl            String?
  status               UserStatus            @default(ACTIVE)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  refreshTokens        RefreshToken[]
  oauthAccounts        OAuthAccount[]
  workspaceMemberships WorkspaceMembership[]
  boardMemberships     BoardMembership[]
  cardAssignments      CardAssignment[]
  comments             Comment[]
  attachments          Attachment[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Workspace {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  description String?
  domainCategory String?
  isFrozen    Boolean               @default(false)
  archivedAt  DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  memberships WorkspaceMembership[]
  boards      Board[]
  invitations WorkspaceInvitation[]
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String                    @id @default(uuid()) @db.Uuid
  workspaceId String                    @db.Uuid
  inviterId   String                    @db.Uuid
  email       String
  tokenHash   String                    @unique
  status      WorkspaceInvitationStatus @default(PENDING)
  expiresAt   DateTime                  @db.Timestamptz(3)
  acceptedAt  DateTime?                 @db.Timestamptz(3)
  rejectedAt  DateTime?                 @db.Timestamptz(3)
  canceledAt  DateTime?                 @db.Timestamptz(3)
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User                      @relation("WorkspaceInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([expiresAt])
}

model Board {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  name        String
  description String?
  archivedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships BoardMembership[]
  lists       List[]
  cards       Card[]
  labels      Label[]

  @@index([workspaceId])
}

model BoardMembership {
  id        String    @id @default(uuid()) @db.Uuid
  boardId   String    @db.Uuid
  userId    String    @db.Uuid
  role      BoardRole @default(MEMBER)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
}

model List {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  position  Float    @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([boardId])
}

model Card {
  id          String           @id @default(uuid()) @db.Uuid
  boardId     String           @db.Uuid
  listId      String           @db.Uuid
  title       String
  position    Float            @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  board       Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list        List             @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignments CardAssignment[]
  tasks       Task[]
  comments    Comment[]
  attachments Attachment[]

  @@index([boardId])
  @@index([listId])
}

model CardAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  cardId     String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([cardId])
  @@index([userId])
}

model Label {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  color     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model Task {
  id          String   @id @default(uuid()) @db.Uuid
  cardId      String   @db.Uuid
  title       String
  isCompleted Boolean  @default(false)
  position    Float    @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
}

model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @db.Uuid
  userId    String   @db.Uuid
  fileName  String
  fileUrl   String
  fileSize  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
}
