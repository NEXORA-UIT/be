POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

REDIS_PORT=6379

# Secret riêng của backend để ký JWT. Tạo một giá trị mới và chỉ lưu trong .env.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-generated-secret-at-least-32-bytes

# Nodemailer Gmail. Bật Google 2-Step Verification rồi tạo App Password.
GMAIL_USER=jack1eno.1.2401@gmail.com
GMAIL_APP_PASSWORD=replace-with-google-app-password

# Frontend URLs được chèn vào email. Frontend chưa chạy vẫn có thể lấy token trên URL để test bằng Swagger.
AUTH_VERIFY_URL=http://localhost:5173/verify-email
AUTH_RESET_URL=http://localhost:5173/reset-password

# Google OAuth Web application. Các giá trị này có thể để trống khi chỉ dùng JWT.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/oauth/callback/google
OAUTH_STATE_TTL_SECONDS=600
