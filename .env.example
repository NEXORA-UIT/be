# Local Docker services only. Copy to .env and replace the password before starting.
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_PORT=5432

REDIS_PORT=6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

# For Gmail delivery, enable 2-Step Verification and create a Gmail App Password.
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password

# AUTH_RESET_URL=https://app.example.com/reset-password
