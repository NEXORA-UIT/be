NODE_ENV=production
PORT=3000

# Dịch vụ production. Điền URL do hạ tầng production cung cấp.
DATABASE_URL=postgresql://user:password@postgres-host:5432/nexora
REDIS_URL=redis://redis-host:6379

# Tạo secret riêng cho production, không dùng lại secret local.
JWT_ACCESS_SECRET=replace-with-production-secret-at-least-32-bytes

# Tài khoản gửi email production.
GMAIL_USER=your-production-email@gmail.com
GMAIL_APP_PASSWORD=replace-with-production-google-app-password

# Frontend production URLs.
AUTH_VERIFY_URL=https://nexora.com/verify-email
AUTH_RESET_URL=https://nexora.com/reset-password

# Google OAuth client dành cho production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nexora.com/oauth/callback/google
OAUTH_STATE_TTL_SECONDS=600
