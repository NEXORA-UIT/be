{
  "name": "nexora-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:local",
    "dev:local": "tsx watch --env-file=.env.local src/server.ts",
    "dev:production": "pnpm build && node --env-file=.env.production dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env.production dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "pnpm infra:up:local",
    "infra:up:local": "docker compose --env-file .env.local -f infrastructure/docker/compose.yaml up -d",
    "db:validate": "node --env-file=.env.local ./node_modules/prisma/build/index.js validate",
    "db:migrate": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate dev",
    "db:generate": "node --env-file=.env.local ./node_modules/prisma/build/index.js generate",
    "db:studio": "node --env-file=.env.local ./node_modules/prisma/build/index.js studio",
    "test": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.12",
    "redis": "^6.2.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
